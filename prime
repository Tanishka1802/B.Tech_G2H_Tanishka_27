#include <stdio.h>
#include <stdbool.h>
int main() 
{
    int n,i;
    printf("Enter number \n");
    bool flag=true;
    scanf("%d", &n);
    for(int i=2;i<n;i++)
    {
        if(n%i==0)
        {
            flag = false;
            break;
        }
           
            
    }
    if(flag)
    printf("%d is prime.",n);
    else
    printf("%d is not prime.",n);
    
    
    return 0;
}
