#include <stdio.h>

int main()
{
    int n,i;
    printf("enter number of elements in array\n");
    scanf("%d",&n);
    int a[n];
    int b[n];
    printf("enter elements in array\n");
    for(i=0;i<n;i++)
    {   
        scanf("%d",&a[i]);
        b[i]=a[i];
    }
    printf("copied array is \n");
    for(i=0;i<n;i++)
    {
        printf("%d \n",b[i]);
            
    }
    
    return 0;
}
