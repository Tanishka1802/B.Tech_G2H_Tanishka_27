#include <stdio.h>

int main() 
{
    int i,n;
    int sum=0;
    int avg;
    printf("enter length of array \n");
    scanf("%d", &n);
    int a[n];
    printf("enter elements of array \n");
    for(i=0;i<n;i++)
    {
        scanf("%d", &a[i]);
    }
    for(i=0;i<n;i++)
    {
        sum = sum+a[i];
    }
