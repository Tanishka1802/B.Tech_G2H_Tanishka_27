#include <stdio.h>
#include <math.h>

int main(){
int a,b,c;
printf("Enter a b c: ");
scanf("%d%d%d",&a,&b,&c);
int d=b*b-4*a*c;
if(a==0){
if(b==0){
if(c==0) printf("Infinite solutions\n");
else printf("No solution\n");
}else{
printf("One root: %d\n",-c/b);
}
return 0;
}
if(d>0){
float x1=(-b+sqrt(d))/(2*a);
float x2=(-b-sqrt(d))/(2*a);
printf("x1=%f\nx2=%f\n",x1,x2);
}else if(d==0){
float x=-b/(2*a);
printf("One real root: %f\n",x);
}else{
float real=-b/(2*a);
float imag=sqrt(-d)/(2*a);
printf("Complex roots: %f+%fi and %f-%fi\n",real,imag,real,imag);
}
return 0;
}
