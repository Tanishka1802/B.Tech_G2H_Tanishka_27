#include <stdio.h>

int main()
{
    int n,i;
    int sum=0;
    printf("enter number of elements in array\n");
    scanf("%d",&n);
    int a[n];
    printf("enter elements o array\n");
    for(i=0;i<n;i++)
    {   
        scanf("%d",&a[i]);
        sum=sum+a[i];
    }
    printf("sum of array is %d \n",sum);
    
    
    return 0;
}
