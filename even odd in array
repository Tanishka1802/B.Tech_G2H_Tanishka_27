#include <stdio.h>

int main()
{
    int n,i;
    int c1=0,c2=0;
    printf("enter number of elements in array\n");
    scanf("%d",&n);
    int a[n];
    printf("enter elements o array\n");
    for(i=0;i<n;i++)
    {   
        scanf("%d",&a[i]);
    }
    for(i=0;i<n;i++)
    {
        if(a[i]%2==0)
            c1=c1+1;
        else
            c2=c2+1;
            
    }
    printf("number of even terms are %d \n",c1);
    printf("number of odd terms are %d \n",c2);
    return 0;
}
