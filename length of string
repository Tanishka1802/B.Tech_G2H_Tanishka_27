#include <stdio.h>
#include <string.h>
int main() 
{
    int n,i=0,len=0;
    printf("enter length of string\n");
    scanf("%d", &n);
    
    char str[n];
    scanf("%s",str);
    
    
    while(str[i]!='\0')
    {
        len=len+1;
        i++;
    }
    printf("length of string is %d", len );
    return 0;
}
