#include <stdio.h>

int main()
{
    int n,i;
    printf("enter number of elements in array\n");
    scanf("%d",&n);
    int a[n];
    printf("enter elements o array\n");
    for(i=0;i<n;i++)
    {   
        scanf("%d",&a[i]);
        
    }
    int max=a[0];
    for(i=0;i<n;i++)
    {   
        if(a[i]>a[0])
            max=a[i];
        else
            max=a[0];
    }
    printf("largest number of array is %d \n",max);
    
    
    return 0;
}
