#include <stdio.h>

int main() {
    int a,b,c;
    printf("enter sides");
    scanf("%d %d %d", &a,&b,&c);
    if(a+b>c||b+c>a||a+c>b)
    {
      printf("valid \n");
      if(a=b=c)
       printf("equilateral");
      else if(a==b||b==c||c==a)
       printf("isosceles");
      else  
       printf("scalene");
    } 
    else
      printf("invalid");
      

    return 0;
}
