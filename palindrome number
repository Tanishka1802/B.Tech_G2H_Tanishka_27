#include <stdio.h>

int main()
{
    int n,x,y;
    int rev=0;
    printf("enter number %d \n");
    scanf("%d", &n);
    y=n;
    while(n>0)
    {
        int x=n%10;
        rev=rev*10+x;
        n=n/10;
    }
    n=y;
    if(n==rev)
    {   
        printf(" number is palindrome");
    }
    else
    {
        printf("not palindrome");
    }
    
    
    return 0;
}
